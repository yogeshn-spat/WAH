  m_Script: {fileID: 11500000, guid: 3e02a45132f335f49b60f6f80272584b, type: 3}
  m_Name: Scene Changing Discription
  m_EditorClassIdentifier: 
  tamilContent: "\u0B87\u0BA8\u0BCD\u0BA4 \u0B89\u0BB0\u0BC1\u0BB5\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0BA4\u0BB2\u0BCD
    \u0B95\u0BB2\u0BCD\u0BB5\u0BBF \u0BA8\u0BCB\u0B95\u0BCD\u0B95\u0B99\u0BCD\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BBE\u0B95
    \u0BAE\u0B9F\u0BCD\u0B9F\u0BC1\u0BAE\u0BC7. \u0B87\u0BA4\u0BC1 \u0BA8\u0BBF\u0B9C
    \u0BB5\u0BBE\u0BB4\u0BCD\u0B95\u0BCD\u0B95\u0BC8 \u0B95\u0BBE\u0B9F\u0BCD\u0B9A\u0BBF\u0B95\u0BB3\u0BC8
    \u0B92\u0BA4\u0BCD\u0BA4\u0BBF\u0BB0\u0BC1\u0BA8\u0BCD\u0BA4\u0BBE\u0BB2\u0BC1\u0BAE\u0BCD,
    \u0B89\u0BA3\u0BCD\u0BAE\u0BC8\u0BAF\u0BBE\u0BA9 \u0B9A\u0BC2\u0BB4\u0BCD\u0BA8\u0BBF\u0BB2\u0BC8\u0B95\u0BB3\u0BCD
    \u0BAE\u0BBE\u0BB1\u0BC1\u0BAA\u0B9F\u0BB2\u0BBE\u0BAE\u0BCD. \u0BA8\u0BBF\u0B9C
    \u0BB5\u0BBE\u0BB4\u0BCD\u0B95\u0BCD\u0B95\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD \u0B95\u0BC8\u0BAF\u0BBE\u0BB3\u0BC1\u0BAE\u0BCD
    \u0BAA\u0BCB\u0BA4\u0BC1 \u0B8E\u0BAA\u0BCD\u0BAA\u0BCB\u0BA4\u0BC1\u0BAE\u0BCD
    \u0B8E\u0B9A\u0BCD\u0B9A\u0BB0\u0BBF\u0B95\u0BCD\u0B95\u0BC8\u0BAF\u0BC1\u0B9F\u0BA9\u0BCD
    \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0B9F\u0BB5\u0BC1\u0BAE\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD
    \u0B9A\u0BB0\u0BBF\u0BAF\u0BBE\u0BA9 \u0BAA\u0BBE\u0BA4\u0BC1\u0B95\u0BBE\u0BAA\u0BCD\u0BAA\u0BC1
    \u0BA8\u0BC6\u0BB1\u0BBF\u0BAE\u0BC1\u0BB1\u0BC8\u0B95\u0BB3\u0BC8\u0BAA\u0BCD
    \u0BAA\u0BBF\u0BA9\u0BCD\u0BAA\u0BB1\u0BCD\u0BB1\u0BB5\u0BC1\u0BAE\u0BCD."
  englishContent: This simulation is for educational purposes only. While it resembles
    real-life scenarios, actual situations may vary. Always exercise caution and
    follow proper safety protocols when dealing in real life.
  hindiContent: "\u092F\u0939 \u0938\u093F\u092E\u0941\u0932\u0947\u0936\u0928 \u0915\u0947\u0935\u0932
    \u0936\u0948\u0915\u094D\u0937\u093F\u0915 \u0909\u0926\u094D\u0926\u0947\u0936\u094D\u092F\u094B\u0902
    \u0915\u0947 \u0932\u093F\u090F \u0939\u0948\u0964 \u0939\u093E\u0932\u093E\u0901\u0915\u093F
    \u092F\u0939 \u0935\u093E\u0938\u094D\u0924\u0935\u093F\u0915 \u091C\u0940\u0935\u0928
    \u0915\u0947 \u092A\u0930\u093F\u0926\u0943\u0936\u094D\u092F\u094B\u0902 \u091C\u0948\u0938\u093E
    \u0939\u0948, \u0932\u0947\u0915\u093F\u0928 \u0935\u093E\u0938\u094D\u0924\u0935\u093F\u0915
    \u092A\u0930\u093F\u0938\u094D\u0925\u093F\u0924\u093F\u092F\u093E\u0901 \u092D\u093F\u0928\u094D\u0928
    \u0939\u094B \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964 \u0935\u093E\u0938\u094D\u0924\u0935\u093F\u0915
    \u091C\u0940\u0935\u0928 \u092E\u0947\u0902 \u0915\u093E\u092E \u0915\u0930\u0924\u0947
    \u0938\u092E\u092F \u0939\u092E\u0947\u0936\u093E \u0938\u093E\u0935\u0927\u093E\u0928\u0940
    \u092C\u0930\u0924\u0947\u0902 \u0914\u0930 \u0909\u091A\u093F\u0924 \u0938\u0941\u0930\u0915\u094D\u0937\u093E
    \u092A\u094D\u0930\u094B\u091F\u094B\u0915\u0949\u0932 \u0915\u093E \u092A\u093E\u0932\u0928
    \u0915\u0930\u0947\u0902\u0964"
