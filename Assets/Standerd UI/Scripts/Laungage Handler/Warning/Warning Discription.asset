  m_Script: {fileID: 11500000, guid: 3e02a45132f335f49b60f6f80272584b, type: 3}
  m_Name: Warning Discription
  m_EditorClassIdentifier: 
  tamilContent: "\u0BAE\u0BC1\u0BB1\u0BC8\u0BAF\u0BBE\u0BA9 \u0BA8\u0BC1\u0B9F\u0BCD\u0BAA\u0BA4\u0BCD\u0BA4\u0BC8
    \u0BAA\u0BB0\u0BBE\u0BAE\u0BB0\u0BBF\u0B95\u0BCD\u0B95 CPR \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BC1\u0BAE\u0BCD
    \u0BAA\u0BCB\u0BA4\u0BC1 \u0B89\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0BAE\u0BC1\u0BB4\u0B99\u0BCD\u0B95\u0BC8\u0B95\u0BB3\u0BCD
    \u0BA8\u0BC7\u0BB0\u0BBE\u0B95 \u0B87\u0BB0\u0BC1\u0BAA\u0BCD\u0BAA\u0BA4\u0BC8
    \u0B89\u0BB1\u0BC1\u0BA4\u0BBF \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
  englishContent: Ensure that your elbows remain straight and locked while performing
    CPR to maintain proper technique.
  hindiContent: "\u0909\u091A\u093F\u0924 \u0924\u0915\u0928\u0940\u0915 \u092C\u0928\u093E\u090F
    \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F CPR \u0915\u0930\u0924\u0947
    \u0938\u092E\u092F \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924 \u0915\u0930\u0947\u0902
    \u0915\u093F \u0906\u092A\u0915\u0940 \u0915\u094B\u0939\u0928\u093F\u092F\u093E\u0902
    \u0938\u0940\u0927\u0940 \u0914\u0930 \u0932\u0949\u0915 \u0930\u0939\u0947\u0902\u0964."
