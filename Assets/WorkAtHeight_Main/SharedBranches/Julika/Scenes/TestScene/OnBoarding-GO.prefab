  m_text: "1. \u0915\u093F\u0938\u0940 \u0939\u0930\u0947 \u0930\u0902\u0917 \u0915\u0940
    \u0939\u093E\u0907\u0932\u093E\u0907\u091F \u0915\u0940 \u0917\u0908 \u0935\u0938\u094D\u0924\u0941
    \u0915\u093E \u0928\u093F\u0930\u0940\u0915\u094D\u0937\u0923 \u092F\u093E \u092A\u0939\u091A\u093E\u0928
    \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0906\u092A \u092E\u0947\u0902
    \u0938\u0947 \u0915\u093F\u0938\u0940 \u090F\u0915 \u0939\u093E\u0925 \u0915\u094B
    \u090A\u092A\u0930 \u0932\u093E\u090F\u0901 \u0914\u0930 \u0909\u0938 \u0935\u0938\u094D\u0924\u0941
    \u0915\u0940 \u0913\u0930 \u0907\u0936\u093E\u0930\u093E \u0915\u0930\u0928\u0947
    \u0915\u093E \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964\r\n(\u0938\u0902\u0926\u0930\u094D\u092D
    \u0915\u0947 \u0932\u093F\u090F \u0938\u0902\u0915\u0947\u0924 \u0935\u0940\u0921\u093F\u092F\u094B
    \u0915\u093E \u092A\u093E\u0932\u0928 \u0915\u0930\u0947\u0902)"
