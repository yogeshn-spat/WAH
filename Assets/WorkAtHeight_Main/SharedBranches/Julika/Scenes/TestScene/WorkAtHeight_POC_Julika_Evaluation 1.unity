  m_text: "1. \u0B92\u0BB0\u0BC1 \u0BAA\u0BCA\u0BB0\u0BC1\u0BB3\u0BC8 \u0B86\u0BAF\u0BCD\u0BB5\u0BC1
    \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF \u0B85\u0BB2\u0BCD\u0BB2\u0BA4\u0BC1 \u0B85\u0B9F\u0BC8\u0BAF\u0BBE\u0BB3\u0BAE\u0BCD
    \u0B95\u0BBE\u0BA3 \u0B89\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0B95\u0BC8\u0B95\u0BB3\u0BBF\u0BB2\u0BCD
    \u0B8F\u0BA4\u0BC7\u0BA9\u0BC1\u0BAE\u0BCD \u0B92\u0BA9\u0BCD\u0BB1\u0BC8 \u0BAE\u0BC7\u0BB2\u0BC7
    \u0B95\u0BCA\u0BA3\u0BCD\u0B9F\u0BC1 \u0BB5\u0BA8\u0BCD\u0BA4\u0BC1 \u0B85\u0BA8\u0BCD\u0BA4
    \u0BAA\u0BCA\u0BB0\u0BC1\u0BB3\u0BBF\u0BA9\u0BCD \u0BAE\u0BC0\u0BA4\u0BC1 \u0B9A\u0BC1\u0B9F\u0BCD\u0B9F\u0BBF\u0B95\u0BCD\u0B95\u0BBE\u0B9F\u0BCD\u0B9F
    \u0BAE\u0BC1\u0BAF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD.\r\n2.
    \u0BAA\u0BB0\u0BBF\u0B9A\u0BCB\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BC1\u0BAE\u0BCD
    \u0B9F\u0BC8\u0BAE\u0BB0\u0BC8\u0BA4\u0BCD \u0BA4\u0BCA\u0B9F\u0B99\u0BCD\u0B95
